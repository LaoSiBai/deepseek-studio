# Copy to .env and fill in. Read by the local proxy only — never exposed to the browser.
LLM_API_KEY=
# Optional: default base URL (still overridable in the UI).
LLM_BASE_URL=https://api.deepseek.com
# Optional: proxy used when forwarding requests (localhost is bypassed automatically).
# HTTPS_PROXY=http://127.0.0.1:7890
